<Window x:Class="Raktár.Statisztika"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raktár"
        mc:Ignorable="d"
        Title="Statisztika" Height="450" Width="800">
    <Grid>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="282,70,282,116"/>
        <Label Content="Eladások termékenként összesen" HorizontalAlignment="Center" Margin="0,22,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnNyomtatas" Content="Nyomtatás" HorizontalAlignment="Center" Margin="0,360,0,0" VerticalAlignment="Top" Width="184" Height="36"/>
        <Button x:Name="btnFomenu" Content="Főmenü" HorizontalAlignment="Left" Margin="656,368,0,0" VerticalAlignment="Top" Width="95" Height="28" Click="btnFomenu_Click"/>

    </Grid>
</Window>
