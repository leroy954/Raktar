<Window x:Class="Raktár.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raktár"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="tbxNev" HorizontalAlignment="Left" Margin="280,166,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="142" Height="34" TextChanged="tbxNev_TextChanged"/>
        <TextBox x:Name="tbxJelszo"  HorizontalAlignment="Left" Margin="280,240,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="142" Height="34"/>
        <Button Content="Belépés" HorizontalAlignment="Left" Margin="282,316,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Width="143" Height="34" Click="Button_Click">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.038"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Label Content="Név" HorizontalAlignment="Left" Margin="194,166,0,0" VerticalAlignment="Top"/>
        <Label Content="Jelszó" HorizontalAlignment="Left" Margin="191,244,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.658,-1.27"/>

    </Grid>
</Window>
