<Window x:Class="Raktár.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raktár"
        mc:Ignorable="d"
        Title="Window1" Height="466" Width="764">
    <Grid>

        <Button Content="Főmenü" HorizontalAlignment="Left" Margin="234,358,0,0" VerticalAlignment="Top" Height="40" Width="108" Click="Button_Click"/>
        <TextBox x:Name="tbxCikkszam" HorizontalAlignment="Left" Margin="514,73,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="17"/>
        <TextBox x:Name="tbxTermeknev" HorizontalAlignment="Left" Margin="514,100,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="tbxTermeknev_TextChanged" Height="23"/>
        <Label Content="Cikkszám:" HorizontalAlignment="Left" Margin="418,73,0,0" VerticalAlignment="Top" Height="27" Width="68" RenderTransformOrigin="0.912,0.823"/>
        <Label Content="Termék neve:" HorizontalAlignment="Left" Margin="410,100,0,0" VerticalAlignment="Top" Height="23" Width="84"/>
        <DataGrid x:Name="dataGrid1" d:ItemsSource="{d:SampleData ItemCount=10}" Margin="4,43,558,-1" SelectionChanged="DataGrid_SelectionChanged" RenderTransformOrigin="0.5,0.5">
            <DataGrid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-0.762"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-1.237"/>
                </TransformGroup>
            </DataGrid.RenderTransform>
        </DataGrid>
        <StackPanel RenderTransformOrigin="0.478,0.473" Margin="382,17,66,244"/>
        <Button x:Name="btnFelvitel" Content="Felvitel" HorizontalAlignment="Left" Margin="574,157,0,0" VerticalAlignment="Top" Width="60" Click="btnFelvitel_Click"/>
        <Label Content="Új termék felvitele" HorizontalAlignment="Left" Margin="504,29,0,0" VerticalAlignment="Top" Width="114"/>
        <StackPanel Margin="382,239,66,52"/>
        <Label Content="Cikkszám" HorizontalAlignment="Left" Margin="422,292,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.578,1.764"/>
        <TextBox x:Name="tbxCikkszam1"  HorizontalAlignment="Left" Margin="514,290,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="29"/>
        <Button x:Name="btnTorles" Content="Törlés" HorizontalAlignment="Left" Margin="570,343,0,0" VerticalAlignment="Top" Width="68" Click="btnTorles_Click"/>
        <Label Content="Termék törlése" HorizontalAlignment="Left" Margin="514,251,0,0" VerticalAlignment="Top" Width="88" Height="26"/>
        <Rectangle HorizontalAlignment="Left" Height="139" Margin="382,239,0,0" Stroke="Black" VerticalAlignment="Top" Width="316"/>
        <Rectangle HorizontalAlignment="Left" Height="189" Margin="381,17,0,0" Stroke="Black" VerticalAlignment="Top" Width="317"/>

    </Grid>
</Window>
