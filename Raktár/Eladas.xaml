<Window x:Class="Raktár.Eladas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raktár"
        mc:Ignorable="d"
        Title="Eladas" Height="450" Width="800">
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="316" Stroke="Black" VerticalAlignment="Center" Width="248"/>
        <Label Content="Új eladás felvitele" HorizontalAlignment="Center" Margin="0,71,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cbxEladas"  HorizontalAlignment="Left" Margin="387,135,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cbxEladas_SelectionChanged"/>
        <Label Content="Termék:" HorizontalAlignment="Left" Margin="304,131,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="tbxDatum" HorizontalAlignment="Left" Margin="380,0,0,0" VerticalAlignment="Center"/>
        <Label Content="Dátum:" HorizontalAlignment="Left" Margin="304,203,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbxMennyiseg" HorizontalAlignment="Left" Margin="387,266,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Mennyiség:" HorizontalAlignment="Left" Margin="294,262,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnEladas" Content="Eladás" HorizontalAlignment="Left" Margin="409,320,0,0" VerticalAlignment="Top" Width="77" Height="32" Click="btnEladas_Click"/>
        <Button x:Name="btnFomenu" Content="Főmenü" HorizontalAlignment="Left" Margin="658,364,0,0" VerticalAlignment="Top" Height="39" Width="83" Click="btnFomenu_Click"/>

    </Grid>
</Window>
